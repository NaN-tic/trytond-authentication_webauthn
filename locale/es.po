msgctxt "help:res.user,webauthn_keys:"
msgid "Rename or revoke registered keys. Use Register Security Key from the Security Keys menu to enroll your own device."
msgstr "Renombra o revoca las claves registradas. Utiliza Registrar una clave de seguridad del menú Claves de seguridad para registrar tu dispositivo."

msgctxt "view:res.user:"
msgid "To enroll your own device, use Security Keys → Register Security Key, then reload this list."
msgstr "Para registrar tu dispositivo, utiliza Claves de seguridad → Registrar una clave de seguridad y recarga esta lista."

msgctxt "model:ir.message,text:msg_verified_registration_required"
msgid "Register security keys using verified WebAuthn enrollment."
msgstr "Registra las claves de seguridad mediante el registro verificado WebAuthn."

msgctxt "model:ir.message,text:msg_credential_immutable"
msgid "Only the name of a registered security key can be changed."
msgstr "Solo se puede modificar el nombre de una clave de seguridad registrada."

msgctxt "model:ir.message,text:msg_credential_owner"
msgid "You can only manage your own security keys in preferences."
msgstr "En las preferencias solo puedes gestionar tus claves de seguridad."

msgctxt "model:ir.message,text:msg_revoke_last_key"
msgid "You are revoking the last security key for \"%(user)s\". A password or another authenticated session will be required to register a replacement. Continue?"
msgstr "Estás revocando la última clave de seguridad de «%(user)s». Se necesitará una contraseña u otra sesión autenticada para registrar una nueva. ¿Quieres continuar?"

