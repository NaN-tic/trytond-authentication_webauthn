msgstr "Identificador de la credencial"

msgctxt "field:res.user.webauthn.credential,credential_public_key:"
msgid "Credential Public Key"
msgstr "Clau pública de la credencial"

msgctxt "field:res.user.webauthn.credential,sign_count:"
msgid "Sign Count"
msgstr "Comptador de signatures"

msgctxt "field:res.user.webauthn.credential,created_at:"
msgid "Created At"
msgstr "Data de registre"

msgctxt "field:res.user.webauthn.credential,last_used_at:"
