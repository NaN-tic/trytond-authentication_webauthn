msgid "Own security keys"
msgstr "Claus de seguretat pròpies"

msgctxt "model:ir.rule.group,name:rule_group_credential_admin"
msgid "All security keys"
msgstr "Totes les claus de seguretat"

msgctxt "help:res.user,webauthn_keys:"
msgid "Rename or revoke registered keys. Use Register Security Key from the Security Keys menu to enroll your own device."
msgstr "Reanomena o revoca les claus registrades. Utilitza Registra una clau de seguretat del menú Claus de seguretat per registrar el teu dispositiu."

msgctxt "view:res.user:"
msgid "To enroll your own device, use Security Keys → Register Security Key, then reload this list."
msgstr "Per registrar el teu dispositiu, utilitza Claus de seguretat → Registra una clau de seguretat i recarrega aquesta llista."

msgctxt "model:ir.message,text:msg_verified_registration_required"
msgid "Register security keys using verified WebAuthn enrollment."
msgstr "Registra les claus de seguretat mitjançant el registre verificat WebAuthn."

msgctxt "model:ir.message,text:msg_credential_immutable"
msgid "Only the name of a registered security key can be changed."
msgstr "Només es pot modificar el nom d’una clau de seguretat registrada."

msgctxt "model:ir.message,text:msg_credential_owner"
msgid "You can only manage your own security keys in preferences."
msgstr "A les preferències només pots gestionar les teves claus de seguretat."

msgctxt "model:ir.message,text:msg_revoke_last_key"
msgid "You are revoking the last security key for \"%(user)s\". A password or another authenticated session will be required to register a replacement. Continue?"
msgstr "Estàs revocant l’última clau de seguretat de «%(user)s». Caldrà una contrasenya o una altra sessió autenticada per registrar-ne una de nova. Vols continuar?"

